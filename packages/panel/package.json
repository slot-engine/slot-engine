{
  "name": "@slot-engine/panel",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/slot-engine/slot-engine"
  },
  "homepage": "https://slot-engine.dev/docs/panel",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build-server": "tsdown",
    "build-client": "cd ./client && tsc -b && vite build",
    "build": "pnpm run build-server && pnpm run build-client",
    "dev-server": "tsx watch ./dev.ts",
    "dev-client": "cd ./client && vite",
    "dev": "concurrently \"pnpm run dev-server\" \"pnpm run dev-client\""
  },
  "files": [
    "dist",
    "dist-client"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/abstract": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@dnd-kit/helpers": "0.5.1",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@mantine/hooks": "9.7.3",
    "@slot-engine/core": "0.4.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/router-plugin": "1.168.48",
    "@tanstack/react-virtual": "3.14.22",
    "@uiw/react-json-view": "2.0.0-alpha.44",
    "@uiw/react-color": "2.10.3",
    "chalk": "6.0.1",
    "cva": "1.0.0-beta.4",
    "hono": "4.13.13",
    "qs": "6.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@slot-engine/lgs": "0.1.0",
    "@tabler/icons-react": "3.49.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qs": "6.15.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}