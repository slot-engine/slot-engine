{
  "name": "slot-engine",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=\"@slot-engine/*\"",
    "dev": "turbo run dev --filter=\"@slot-engine/*\"",
    "docs:dev": "turbo run dev --filter=\"docs\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "publish-release": "pnpm install --frozen-lockfile=false && pnpm --filter=\"@slot-engine/*\" build && pnpm changeset publish"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/get-github-info": "1.0.1",
    "dotenv": "18.0.1",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest":"5.0.5"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=23.8.0"
  }
}